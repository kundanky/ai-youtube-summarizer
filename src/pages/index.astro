---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import TabSwitcher from "../components/TabSwitcher.astro";
import Source from "../components/Source.astro";
import UrlCard from "../components/UrlCard.astro";
import SummaryCard from "../components/SummaryCard.astro";
---

<Layout>
    <Header />
    <main class="min-h-dvh px-4 sm:px-6">
        <div class="w-full max-w-xl mx-auto">
            <Hero />
            <TabSwitcher />
            <div id="link-tab-content">
                <Source />
                <UrlCard />
            </div>
            <SummaryCard />
        </div>
    </main>
</Layout>
