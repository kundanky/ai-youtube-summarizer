---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="min-h-screen bg-zinc-950 text-white flex items-center justify-center px-5 py-10">

    <div class="w-full max-w-3xl">

      <div class="text-center">
        <div class="text-6xl mb-4">🎬</div>

        <h1 class="text-5xl font-extrabold tracking-tight">
          AI YouTube Summarizer
        </h1>

        <p class="mt-4 text-zinc-400 text-lg">
          Turn long YouTube videos into short, powerful summaries in seconds.
        </p>
      </div>

      <div class="mt-10 rounded-3xl bg-zinc-900 border border-zinc-800 p-6 shadow-2xl">

        <label class="block text-sm text-zinc-400 mb-3">
          YouTube Video URL
        </label>

        <input
          type="text"
          placeholder="https://youtube.com/watch?v=..."
          class="w-full rounded-2xl bg-zinc-800 border border-zinc-700 p-4 text-white outline-none focus:border-violet-500"
        />

        <button
          class="mt-5 w-full rounded-2xl bg-gradient-to-r from-violet-600 to-blue-600 p-4 font-bold text-lg transition hover:scale-[1.02]">
          🚀 Generate Summary
        </button>

      </div>

      <div class="mt-8 rounded-3xl bg-zinc-900 border border-zinc-800 p-6">

        <h2 class="text-2xl font-bold mb-4">
          ✨ AI Summary
        </h2>

        <div class="rounded-2xl bg-zinc-800 p-5 text-zinc-300 leading-8">
          Your AI-generated summary will appear here...
        </div>

      </div>

    </div>

  </main>
</Layout>
