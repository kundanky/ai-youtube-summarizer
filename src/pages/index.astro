---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import UrlCard from "../components/UrlCard.astro";
import SummaryCard from "../components/SummaryCard.astro";

import "../styles/home.css";
---

<Layout>
<main class="min-h-dvh bg-black text-white px-4 sm:px-6 pt-8 pb-12 md:pt-14 md:pb-20 relative overflow-hidden">
    <!-- Ambient monochrome glow -->
    <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
      <div class="w-[600px] h-[600px] rounded-full bg-white/5 blur-3xl"></div>
    </div>
<div class="w-full max-w-xl mx-auto relative">
      <Hero />
      <UrlCard />
      <SummaryCard />
    </div>

  </main>
</Layout>
