---
import Layout from "../layouts/Layout.astro";
---

<html lang="en">
<Layout>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AI YouTube Summarizer</title>
  </head>

  <body class="bg-zinc-950 text-white min-h-screen flex items-center justify-center p-6">
    <main class="w-full max-w-2xl">

      <h1 class="text-5xl font-bold text-center">
        🎬 AI YouTube Summarizer
      </h1>

      <p class="text-center text-gray-400 mt-3 mb-8">
        Paste any YouTube video and get an AI-powered summary in seconds.
      </p>

      <div class="bg-zinc-900 rounded-2xl p-6 shadow-xl">

        <input
          type="text"
          placeholder="https://youtube.com/..."
          class="w-full p-4 rounded-xl text-black"
        />

        <button
          class="w-full mt-4 bg-red-600 hover:bg-red-700 transition p-4 rounded-xl font-bold">
          🚀 Summarize
        </button>

      </div>

      <div class="mt-8 bg-zinc-900 rounded-2xl p-6">

        <h2 class="text-2xl font-bold mb-4">
          Summary
        </h2>

        <p class="text-gray-300">
          Your AI-generated summary will appear here...
        </p>

      </div>

    </main>
  </body>
</html>
</Layout>
