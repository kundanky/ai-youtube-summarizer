---
---

<section class="space-y-4">

    <input
      id="yt-url"
      type="url"
      placeholder="Paste YouTube link here..."
      autocomplete="off"
      spellcheck="false"
      class="input-field"
    />

    <p
      id="yt-error"
      class="hidden text-sm text-red-500">
    </p>

    <button
      id="yt-submit"
      disabled
      class="btn-primary flex items-center justify-center gap-2">
      <span class="spinner hidden w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
      Generate Summary
    </button>
  
  <div
    id="yt-preview"
    class="hidden card p-2 mt-4 transition-all duration-300">

    <img
      id="yt-thumb"
      src=""
      alt=""
      class="aspect-video w-full object-cover rounded-[calc(var(--radius-input)-4px)]" />

    <div
      id="yt-thumb-skeleton"
      class="hidden aspect-video w-full animate-pulse bg-zinc-200 dark:bg-zinc-800 rounded-[calc(var(--radius-input)-4px)]">
    </div>

    <div class="p-3">

      <h3
        id="yt-title"
        class="font-medium text-sm leading-snug text-zinc-900 dark:text-zinc-100">
      </h3>

      <p
        id="yt-channel"
        class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">
      </p>

    </div>

  </div>

</section>
<script>
  // Show empty state by default
  const emptyState = document.getElementById('empty-state');
  emptyState?.classList.remove('hidden');
  emptyState?.classList.add('flex');

  function extractVideoId(url) {
    const patterns = [
      /youtube\.com\/watch\?v=([^&\n?#]+)/,
      /youtube\.com\/embed\/([^&\n?#]+)/,
      /youtube\.com\/shorts\/([^&\n?#]+)/,
      /youtu\.be\/([^&\n?#]+)/,
    ];

    for (const pattern of patterns) {
      const match = url.match(pattern);
      if (match) return match[1];
    }

    return null;
  }

  const input = document.getElementById("yt-url");
  const errorEl = document.getElementById("yt-error");
  const preview = document.getElementById("yt-preview");
  const thumb = document.getElementById("yt-thumb");
  const thumbSkeleton = document.getElementById("yt-thumb-skeleton");
  const titleEl = document.getElementById("yt-title");
  const channelEl = document.getElementById("yt-channel");
  const submitBtn = document.getElementById("yt-submit");
  const spinner = submitBtn?.querySelector('.spinner');

  let debounceTimer;
  let currentRequestId = 0;

  function resetPreview() {
    preview?.classList.add("hidden");
    errorEl?.classList.add("hidden");
    if(submitBtn) (submitBtn as HTMLButtonElement).disabled = true;
    emptyState?.classList.remove('hidden');
    emptyState?.classList.add('flex');
  }

  async function handleInput() {
    const url = (input as HTMLInputElement)?.value.trim();

    clearTimeout(debounceTimer);

    if (!url) {
      resetPreview();
      return;
    }

    const videoId = extractVideoId(url);

    if (!videoId) {
      preview?.classList.add("hidden");
      if(errorEl) {
          errorEl.classList.remove("hidden");
          errorEl.textContent = "Please enter a valid YouTube URL.";
      }
      if(submitBtn) (submitBtn as HTMLButtonElement).disabled = true;
      emptyState?.classList.remove('hidden');
      emptyState?.classList.add('flex');
      return;
    }

    errorEl?.classList.add("hidden");

    debounceTimer = setTimeout(() => {
      fetchVideoInfo(url, videoId);
    }, 400);
  }

  async function fetchVideoInfo(url, videoId) {
    const requestId = ++currentRequestId;

    if(thumb) (thumb as HTMLImageElement).src = `https://img.youtube.com/vi/${videoId}/mqdefault.jpg`;
    thumbSkeleton?.classList.remove("hidden");
    
    // UI state
    spinner?.classList.remove('hidden');
    if(input) (input as HTMLInputElement).disabled = true;
    
    if(titleEl) titleEl.textContent = "Fetching video...";
    if(channelEl) channelEl.textContent = "";

    preview?.classList.remove("hidden");
    emptyState?.classList.add('hidden');
    emptyState?.classList.remove('flex');
    if(submitBtn) (submitBtn as HTMLButtonElement).disabled = true;

    try {
      const response = await fetch(
        `https://www.youtube.com/oembed?url=${encodeURIComponent(url)}&format=json`
      );

      if (requestId !== currentRequestId) return;

      if (!response.ok) throw new Error();

      const data = await response.json();
      if(titleEl) titleEl.textContent = data.title || "Untitled video";

      if(channelEl) channelEl.textContent = data.author_name || "";

      if (data.thumbnail_url && thumb) {
        (thumb as HTMLImageElement).src = data.thumbnail_url;
      }

      if(submitBtn) (submitBtn as HTMLButtonElement).disabled = false;
    } catch {
      if (requestId !== currentRequestId) return;

      preview?.classList.add("hidden");
      if(errorEl) {
        errorEl.textContent =
          "Couldn't find that video. Check the link and try again.";
        errorEl.classList.remove("hidden");
      }
      if(submitBtn) (submitBtn as HTMLButtonElement).disabled = true;
      emptyState?.classList.remove('hidden');
      emptyState?.classList.add('flex');
    } finally {
      if (requestId === currentRequestId) {
        thumbSkeleton?.classList.add("hidden");
        spinner?.classList.add('hidden');
        if(input) (input as HTMLInputElement).disabled = false;
      }
    }
  }

  thumb?.addEventListener("load", () => {
    thumbSkeleton?.classList.add("hidden");
  });

  input?.addEventListener("input", handleInput);
</script>
