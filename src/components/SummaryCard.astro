---
import "../styles/home.css";
---

<section class="mt-5 rounded-[30px] border border-white/10 bg-white/[0.03] backdrop-blur-2xl overflow-hidden">

  <div class="flex items-center justify-between px-5 py-4 border-b border-white/5">

    <div>
      <p class="text-[11px] uppercase tracking-[0.18em] text-zinc-500">
        AI SUMMARY
      </p>
    </div>

    <div class="flex gap-2">
      <button
        id="copy-btn"
        class="rounded-xl border border-white/10 px-3 py-2 text-xs text-zinc-400 hover:bg-white/5">
        Copy
      </button>

      <button
        id="download-btn"
        class="rounded-xl border border-white/10 px-3 py-2 text-xs text-zinc-400 hover:bg-white/5">
        Download
      </button>
    </div>

  </div>

  <div class="p-5">

    <div
      id="summary-box"
      class="min-h-[220px] rounded-2xl border border-white/10 bg-black/20 p-5">

      <p
        id="summary-content"
        class="text-zinc-400 leading-8">

        Your AI summary will appear here once you generate it.

      </p>

    </div>

  </div>

</section>
