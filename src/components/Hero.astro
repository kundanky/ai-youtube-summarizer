---
import "../styles/home.css";
---

<div class="text-center mb-6">

  <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-3 py-1 text-[10px] uppercase tracking-[0.2em] text-zinc-500">
    <div class="w-1.5 h-1.5 rounded-full bg-white/60"></div>
    AI VIDEO DIGEST
  </div>

  <h1 class="mt-5 font-display text-5xl sm:text-6xl md:text-7xl font-bold tracking-tight leading-[0.92]">
    Every video,<br />
    in a minute.
  </h1>

  <p class="mt-4 max-w-sm mx-auto text-zinc-400 text-sm sm:text-base leading-relaxed">
    Paste a YouTube link and instantly get the plot,
    key ideas and conclusion — without watching the
    whole video.
  </p>

</div>
