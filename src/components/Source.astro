---
const sources = ['YouTube', 'Instagram', 'X (Twitter)', 'TikTok'];
---

<select 
    class="w-full px-4 py-2.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-950 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 outline-none transition-all text-sm"
    aria-label="Select content source"
>
    {sources.map(source => <option value={source}>{source}</option>)}
</select>
