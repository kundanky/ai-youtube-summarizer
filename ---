---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="min-h-screen bg-black text-white flex items-center justify-center px-5 py-16 md:py-24 relative overflow-hidden">

    <!-- ambient monochrome glow, single restrained motion element -->
    <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
      <div class="w-[600px] h-[600px] rounded-full bg-white/5 blur-3xl"></div>
    </div>

    <div class="w-full max-w-2xl relative">

      <!-- HERO -->
      <div class="text-center">
        <div class="inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.25em] text-zinc-500 mb-6">
          <span class="w-6 h-px bg-zinc-700"></span>
          AI Video Digest
          <span class="w-6 h-px bg-zinc-700"></span>
        </div>

        <h1 class="font-display text-6xl md:text-7xl font-bold tracking-tight leading-[0.95] text-white">
          Every video,<br />in a minute.
        </h1>

        <!-- signature: a film-scrubber line, the one animated moment on the page -->
        <div class="mx-auto mt-8 h-px w-40 bg-zinc-800 relative overflow-hidden rounded-full">
          <div class="absolute inset-y-0 left-0 w-1/3 bg-white/70 rounded-full animate-scrub"></div>
        </div>

        <p class="mt-8 text-zinc-400 text-lg max-w-md mx-auto leading-relaxed">
          Paste a link. Get the plot, the point, and the punchline —
          without the runtime.
        </p>
      </div>

      <!-- INPUT CARD -->
      <div class="mt-12 rounded-[28px] bg-white/[0.03] backdrop-blur-xl border border-white/10 p-7 shadow-[0_20px_60px_-20px_rgba(0,0,0,0.8)] film-strip">

        <label for="yt-url" class="block text-xs uppercase tracking-widest text-zinc-500 mb-3">
          YouTube video URL
        </label>

        <div class="relative">
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757M10.81 15.312a4.5 4.5 0 0 1-1.242-7.244l4.5-4.5a4.5 4.5 0 0 1 6.364 6.364l-1.757 1.757" />
          </svg>

          <input
            id="yt-url"
            type="text"
            placeholder="https://youtube.com/watch?v=…"
            autocomplete="off"
            spellcheck="false"
            class="w-full rounded-2xl bg-black/40 border border-white/10 pl-12 pr-4 py-4 text-white placeholder-zinc-600 outline-none transition focus:border-white/40 focus:bg-black/60"
          />
        </div>

        <p id="yt-error" class="hidden mt-3 text-sm text-zinc-500">
          That doesn't look like a YouTube link yet.
        </p>

        <!-- live video preview, hidden until a valid link is detected -->
        <div id="yt-preview" class="hidden mt-5 rounded-2xl bg-white/[0.03] border border-white/10 p-3">
          <div class="flex gap-4 items-center">
            <div class="relative w-28 h-16 shrink-0 rounded-lg overflow-hidden bg-zinc-900 border border-white/10">
              <img id="yt-thumb" src="" alt="" class="w-full h-full object-cover" />
              <div id="yt-thumb-skeleton" class="absolute inset-0 animate-pulse bg-zinc-800"></div>
            </div>
            <div class="min-w-0">
              <p id="yt-title" class="text-sm font-medium text-white truncate leading-snug"></p>
              <p id="yt-channel" class="text-xs text-zinc-500 mt-1 truncate"></p>
            </div>
          </div>
        </div>

        <button
          id="yt-submit"
          disabled
          class="mt-6 w-full rounded-2xl bg-zinc-200 disabled:bg-white/10 disabled:text-zinc-600 disabled:cursor-not-allowed text-black p-4 font-semibold text-base tracking-tight transition-all hover:enabled:bg-white hover:enabled:scale-[1.01] active:enabled:scale-[0.99]">
          Generate summary
        </button>
      </div>

      <!-- SUMMARY CARD -->
      <div class="mt-6 rounded-[28px] bg-white/[0.03] backdrop-blur-xl border border-white/10 p-7">

        <div class="flex items-center gap-2 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-white/60"></span>
          <h2 class="text-sm uppercase tracking-widest text-zinc-500">
            Summary
          </h2>
        </div>

        <div class="rounded-2xl bg-black/30 border border-white/5 p-5 text-zinc-400 leading-8">
          Your summary will appear here once you generate it.
        </div>

      </div>

    </div>
  </main>
</Layout>

<style>
  @keyframes scrub {
    0%   { transform: translateX(-100%); }
    50%  { transform: translateX(160%); }
    100% { transform: translateX(-100%); }
  }
  .animate-scrub {
    animation: scrub 3.2s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-scrub { animation: none; }
  }

  /* faint sprocket-hole strip along the top edge of the input card — a quiet film reference */
  .film-strip {
    position: relative;
  }
  .film-strip::before {
    content: "";
    position: absolute;
    top: 10px;
    left: 24px;
    right: 24px;
    height: 3px;
    background-image: radial-gradient(circle, rgba(255,255,255,0.14) 1.5px, transparent 1.5px);
    background-size: 10px 3px;
    background-repeat: repeat-x;
    pointer-events: none;
  }

  .font-display {
    font-family: "Bebas Neue", "Inter", sans-serif;
    letter-spacing: -0.01em;
  }
</style>

<script>
  const input = document.getElementById("yt-url") as HTMLInputElement;
  const errorEl = document.getElementById("yt-error") as HTMLElement;
  const preview = document.getElementById("yt-preview") as HTMLElement;
  const thumb = document.getElementById("yt-thumb") as HTMLImageElement;
  const thumbSkeleton = document.getElementById("yt-thumb-skeleton") as HTMLElement;
  const titleEl = document.getElementById("yt-title") as HTMLElement;
  const channelEl = document.getElementById("yt-channel") as HTMLElement;
  const submitBtn = document.getElementById("yt-submit") as HTMLButtonElement;

  function extractVideoId(url: string): string | null {
    const patterns = [
      /youtube\.com\/watch\?v=([^&\n?#]+)/,
      /youtube\.com\/embed\/([^&\n?#]+)/,
      /youtube\.com\/shorts\/([^&\n?#]+)/,
      /youtu\.be\/([^&\n?#]+)/,
    ];
    for (const p of patterns) {
      const m = url.match(p);
      if (m) return m[1];
    }
    return null;
  }

  let debounceTimer: ReturnType<typeof setTimeout>;
  let currentRequestId = 0;

  function resetPreview() {
    preview.classList.add("hidden");
    errorEl.classList.add("hidden");
    submitBtn.disabled = true;
  }

  async function handleInput() {
    const url = input.value.trim();
    clearTimeout(debounceTimer);

    if (!url) {
      resetPreview();
      return;
    }

    const videoId = extractVideoId(url);

    if (!videoId) {
      preview.classList.add("hidden");
      errorEl.classList.remove("hidden");
      submitBtn.disabled = true;
      return;
    }

    errorEl.classList.add("hidden");

    debounceTimer = setTimeout(() => fetchVideoInfo(url, videoId), 400);
  }

  async function fetchVideoInfo(url: string, videoId: string) {
    const requestId = ++currentRequestId;

    thumb.src = `https://img.youtube.com/vi/${videoId}/mqdefault.jpg`;
    thumbSkeleton.classList.remove("hidden");
    titleEl.textContent = "Fetching video…";
    channelEl.textContent = "";
    preview.classList.remove("hidden");
    submitBtn.disabled = true;

    try {
      const res = await fetch(
        `https://www.youtube.com/oembed?url=${encodeURIComponent(url)}&format=json`
      );

      if (requestId !== currentRequestId) return; // a newer request has since started

      if (!res.ok) throw new Error("not found");

      const data = await res.json();

      titleEl.textContent = data.title ?? "Untitled video";
      channelEl.textContent = data.author_name ?? "";
      thumb.src = data.thumbnail_url ?? thumb.src;
      submitBtn.disabled = false;
    } catch {
      if (requestId !== currentRequestId) return;
      preview.classList.add("hidden");
      errorEl.textContent = "Couldn't find that video — check the link and try again.";
      errorEl.classList.remove("hidden");
      submitBtn.disabled = true;
    } finally {
      if (requestId === currentRequestId) thumbSkeleton.classList.add("hidden");
    }
  }

  thumb.addEventListener("load", () => thumbSkeleton.classList.add("hidden"));
  input.addEventListener("input", handleInput);
</script>
